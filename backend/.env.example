PORT=3000
NODE_ENV=development

# Allowed browser origin for CORS (cookie-based auth requires credentials)
FRONTEND_URL=http://localhost:5173

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weekly_report_generator?schema=public"

# JWT configuration for access tokens
JWT_SECRET=replace-with-a-secure-development-secret
JWT_EXPIRES_IN=1h
